# Firebase Admin service account (Firebase console → Project settings →
# Service accounts → Generate new private key). Copy to .env.local for local dev
# and into Vercel env vars for Production + Preview. Never prefix with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Paste private_key from the JSON as-is, with its literal \n sequences.
FIREBASE_PRIVATE_KEY=""

# Optional: use the local Firestore emulator instead (e.g. "127.0.0.1:8080").
# When set, FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY may be left blank.
FIRESTORE_EMULATOR_HOST=""
